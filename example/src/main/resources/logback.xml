<configuration>

  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <logger name="av.kabanov.example.internal" level="INFO" />
  <logger name="av.kabanov.example.app" level="INFO" />

  <!-- Корневой логгер для сторонних библиотек -->
  <root level="INFO">
    <appender-ref ref="STDOUT" />
  </root>

</configuration>
